# ==============================================================================
# 🌐 ATELION WORKSPACE - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Server Port
PORT=3000

# Client Application URL
CLIENT_URL=http://localhost:5000

# MongoDB Connection String (Atlas NoSQL Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/atelion?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# 📧 Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender_email@domain.com
BREVO_FROM_NAME=Atelion Workspace

# 🔑 Google OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 🗄️ Isolated Turso Database (Help Desk & Support System)
# Can be a remote Turso LibSQL URL or local sqlite file: file:./helpdesk.db
TURSO_HELPDESK_URL=libsql://your-helpdesk-db-name.turso.io
TURSO_HELPDESK_AUTH_TOKEN=your_turso_auth_token_here


# ==============================================================================
# 🧠 100% ZERO-CARD / ZERO-PAYMENT AI WATERFALL KEYS
# 100% Free • Zero Credit Card • Zero Billing Setup Required
# 100% Western / Allied Security: USA 🇺🇸 • Zero Chinese Models
# (Removed Mistral, Cohere & Cerebras which require credit card / billing setup)
# ==============================================================================
# Tier 1 🥇: Groq LPU (USA - Llama 3.3 70B @ 800 tok/sec, 14,400 free requests/day • 0 Card)
GROQ_API_KEY=your_groq_api_key_here

# Tier 2 🥈: Google Gemini 2.0 Flash / Flash-Lite (USA - 1M Context, 1,500 free requests/day • 0 Card)
GEMINI_API_KEY=your_gemini_api_key_here

# Tier 3 🥉: Cloudflare Workers AI (USA - Edge GPU, 10,000 free neurons/day • 0 Card)
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Tier 4: SambaNova Cloud (USA - Dedicated RDU Llama 3.3 70B & 90B Vision • 0 Card)
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Tier 5 🐙: GitHub Models / Microsoft Azure (USA - GPT-4o-mini & Vision, 150 requests/day • 0 Card)
GITHUB_MODELS_TOKEN=ghp_your_github_token_here
GITHUB_TOKEN=ghp_your_github_token_here

# Tier 6 🤗: Hugging Face Serverless Router (USA/France - Llama 3.3 70B & Vision, 100% Free Serverless • 0 Card)
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here

# Tier 7 🌐: OpenRouter Free Tier (USA - Llama 3.3 70B:free & Vision:free • 0 Card)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
