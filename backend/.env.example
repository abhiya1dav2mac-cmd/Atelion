# ==============================================================================
# 🌐 ATELION WORKSPACE - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Server Port
PORT=3000

# Client Application URL
CLIENT_URL=http://localhost:5000

# MongoDB Connection String (Atlas NoSQL Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/atelion?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# 📧 Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender_email@domain.com
BREVO_FROM_NAME=Atelion Workspace

# 🔑 Google OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 🗄️ Isolated Turso Database (Help Desk & Support System)
# Can be a remote Turso LibSQL URL or local sqlite file: file:./helpdesk.db
TURSO_HELPDESK_URL=libsql://your-helpdesk-db-name.turso.io
TURSO_HELPDESK_AUTH_TOKEN=your_turso_auth_token_here


# ==============================================================================
# 🧠 8-TIER NON-CHINESE AI WATERFALL KEYS (USA, FRANCE, CANADA)
# 100% Western / Allied Security - Zero Chinese Models
# ==============================================================================
# Branch A: Text & Code Waterfall
# Tier 1: Cerebras Cloud (USA - Llama 3.3 70B @ 2,000 tok/sec, 1M free tokens/day)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Tier 2: Groq LPU (USA - Llama 3.3 70B @ 800 tok/sec, 14,400 free requests/day)
GROQ_API_KEY=your_groq_api_key_here

# Tier 3: Cloudflare Workers AI (USA - Edge GPU, 10,000 free neurons/day)
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Tier 4: Google Gemini 2.0 Flash (USA - 1M Context, 1,500 free requests/day)
GEMINI_API_KEY=your_gemini_api_key_here

# Tier 5: SambaNova Cloud (USA - Dedicated RDU Llama 3.3 70B & 90B Vision)
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Tier 6: Mistral AI (France - Codestral & Pixtral 12B Vision)
MISTRAL_API_KEY=your_mistral_api_key_here

# Tier 7: GitHub Models / Microsoft (USA - GPT-4o-mini via Azure AI)
GITHUB_TOKEN=your_github_personal_access_token_here

# Tier 8: Cohere AI (Canada - Command R+ Academic Citations)
COHERE_API_KEY=your_cohere_api_key_here
